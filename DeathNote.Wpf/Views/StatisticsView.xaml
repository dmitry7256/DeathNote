<UserControl x:Class="DeathNote.Wpf.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:DeathNote.Wpf.Charts"
             MinHeight="0" ClipToBounds="True">
  <Grid MinHeight="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="63"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*" MinHeight="0"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*" MinHeight="0"/>
    </Grid.RowDefinitions>
    <UniformGrid Grid.Row="0" Columns="4">
      <Border Background="{StaticResource Card}" CornerRadius="8" Margin="0,0,7,0" Padding="11,7">
        <StackPanel><TextBlock Text="MATCHES" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{Binding Stats.Total}" FontSize="23" FontWeight="SemiBold"/></StackPanel>
      </Border>
      <Border Background="{StaticResource Card}" CornerRadius="8" Margin="0,0,7,0" Padding="11,7">
        <StackPanel><TextBlock Text="WINS" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{Binding Stats.Wins}" FontSize="23" FontWeight="SemiBold" Foreground="#FFE1A4BA"/></StackPanel>
      </Border>
      <Border Background="{StaticResource Card}" CornerRadius="8" Margin="0,0,7,0" Padding="11,7">
        <StackPanel><TextBlock Text="DECIDED" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{Binding Stats.Decided}" FontSize="23" FontWeight="SemiBold"/></StackPanel>
      </Border>
      <Border Background="{StaticResource Card}" CornerRadius="8" Padding="11,7">
        <StackPanel><TextBlock Text="WIN RATE" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{Binding Stats.WinRate}" FontSize="23" FontWeight="SemiBold" Foreground="#FFE1A4BA"/></StackPanel>
      </Border>
    </UniformGrid>

    <Grid Grid.Row="2" MinHeight="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="9" Padding="11,8">
        <Grid MinHeight="0">
          <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="MATCH ACTIVITY · LAST 8 MONTHS" Style="{StaticResource Eyebrow}"/>
          <charts:MonthlyActivity Grid.Row="1" Values="{Binding Stats.Months}"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="9" Padding="11,8">
        <Grid MinHeight="0">
          <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="RESULTS COMPARISON" Style="{StaticResource Eyebrow}"/>
          <charts:ResultBars Grid.Row="1" Values="{Binding Stats.Results}"/>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="4" MinHeight="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="9" Padding="11,8">
        <Grid MinHeight="0">
          <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="MAPS" Style="{StaticResource Eyebrow}"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,2,0,0">
            <charts:ResultBars Values="{Binding Stats.Maps}"/>
          </ScrollViewer>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="9" Padding="11,8">
        <Grid MinHeight="0">
          <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="YOUR CIVILIZATIONS" Style="{StaticResource Eyebrow}"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,2,0,0">
            <charts:ResultBars Values="{Binding Stats.Civilizations}" ShowCivilizationIcons="True"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
