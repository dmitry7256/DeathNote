<Window x:Class="DeathNote.Wpf.Views.NicknameHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:markup="clr-namespace:DeathNote.Wpf.Infrastructure"
        Title="Nickname history" Width="590" Height="410" MinWidth="510" MinHeight="335"
        Background="{StaticResource Sidebar}" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- A single start edge is used for each header and the matching cell.
         DataGrid adds 3 DIP of cell padding; the text margin below compensates
         for it so values line up with their headers at any DPI. -->
    <Style x:Key="HistoryAlignedText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="ToolTip" Value="{x:Null}"/>
    </Style>
    <Style x:Key="HistoryAlignedHeader" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="11,4,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid Background="Transparent">
              <Border Background="Transparent" Padding="11,2,18,2">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Border>
              <Thumb x:Name="PART_RightHeaderGripper" Width="4" HorizontalAlignment="Right" Cursor="SizeWE">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
              </Thumb>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border Background="{StaticResource Sidebar}" BorderBrush="#FF3D2D38" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="{StaticResource Sidebar}">
        <Border Background="Transparent" Margin="0,0,43,0" MouseLeftButtonDown="DragTitle">
          <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Nickname history" FontWeight="SemiBold" FontSize="13"/>
          </StackPanel>
        </Border>
        <Button Grid.Column="1" Style="{StaticResource CaptionButton}" Content="×" Tag="Close"
                HorizontalAlignment="Right" ToolTip="Close" Click="CloseClicked"/>
        <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom"/>
      </Grid>
      <Grid Grid.Row="1" Margin="16,10,16,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="PlayerName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="PlayerId" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource SubtleButton}" Content="Copy ID" Width="70" Height="26" Margin="10,0,0,0" Click="CopyIdClicked"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
              <TextBlock x:Name="TotalCount" FontSize="11" Foreground="{StaticResource Muted}"/>
            </Border>
          </Grid>
          <Grid Grid.Row="1" Margin="0,0,0,9">
            <TextBox x:Name="HistorySearch" Height="32" Style="{StaticResource SearchInputTextBox}"
                     TextChanged="FilterChanged" ToolTip="Search nickname history"/>
          </Grid>
          <DataGrid Grid.Row="2" x:Name="HistoryGrid" BorderThickness="0" Background="Transparent"
                    IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="43" ElementStyle="{StaticResource HistoryAlignedText}" HeaderStyle="{StaticResource HistoryAlignedHeader}"/>
              <DataGridTemplateColumn Header="Nickname" Width="*" MinWidth="120" HeaderStyle="{StaticResource HistoryAlignedHeader}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock markup:Civ5MarkupText.Markup="{Binding Nickname}" FontSize="12"
                               Foreground="{StaticResource Fg}" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}" SortMemberPath="FirstSeenSortKey" Width="160" ElementStyle="{StaticResource HistoryAlignedText}" HeaderStyle="{StaticResource HistoryAlignedHeader}"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="86" ElementStyle="{StaticResource HistoryAlignedText}" HeaderStyle="{StaticResource HistoryAlignedHeader}"/>
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CopyFeedback" Grid.Column="0" Text="" Foreground="#FFA9DDBE"
                       FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Copy nickname" Click="CopyNicknameClicked" Width="126" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Close" Click="CloseClicked" Width="94"/>
          </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
