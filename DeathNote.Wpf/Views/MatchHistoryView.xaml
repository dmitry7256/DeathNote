<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:markup="clr-namespace:DeathNote.Wpf.Infrastructure" x:Class="DeathNote.Wpf.Views.MatchHistoryView">
  <UserControl.Resources>
    <Style x:Key="PlayerFilterChip" TargetType="CheckBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="ChipBackground" Background="{StaticResource Field}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5"
                    Padding="7,5">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StateDot" Width="8" Height="8" CornerRadius="2"
                        Background="{StaticResource Disabled}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ChipBackground" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="ChipBackground" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="StateDot" Property="Background" Value="#FFF1B8CB"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChipBackground" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ParticipantLink" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="#FFE6D4DD"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,1">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFB9CC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="244"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" MinWidth="0" Margin="14,10,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Same transparent, single-row filter toolbar as Players; no shared background. -->
      <Grid Grid.Row="0" Margin="0,0,0,9">
        <Grid Height="33">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="94"/>
            <ColumnDefinition Width="113"/>
            <ColumnDefinition Width="*" MinWidth="95"/>
            <ColumnDefinition Width="61"/>
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" Content="Favorites" Style="{StaticResource PlayerFilterChip}"
                    IsChecked="{Binding MatchFavoritesOnly}" Margin="0,0,6,0"/>
          <CheckBox Grid.Column="1" Content="Review only" Style="{StaticResource PlayerFilterChip}"
                    IsChecked="{Binding ReviewOnly}" Margin="0,0,7,0"/>
          <TextBox Grid.Column="2" x:Name="MatchSearch" AutomationProperties.Name="Search matches"
                   Height="32" Style="{StaticResource SearchInputTextBox}" Margin="0,0,7,0"
                   Text="{Binding MatchQuery,UpdateSourceTrigger=PropertyChanged}"/>
          <Button Grid.Column="3" Style="{StaticResource SubtleButton}" Content="Reset"
                  Height="32" FontSize="12" Click="ResetMatchFilters"/>
        </Grid>
      </Grid>

      <Grid Background="Transparent" ClipToBounds="True" Grid.Row="1">
        <DataGrid x:Name="MatchesGrid" ItemsSource="{Binding MatchView}" SelectedItem="{Binding SelectedMatch,Mode=TwoWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" Sorting="MatchesGridSorting" CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="★" Width="42" SortMemberPath="Favorite" CanUserSort="True"
                                    HeaderStyle="{StaticResource FavoriteSortHeader}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding FavoriteGlyph}" FontSize="18"
                             HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Favorite}" Value="True">
                            <Setter Property="Foreground" Value="#FFF1C66F"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Civ" Width="52" MinWidth="52" CanUserSort="True" SortMemberPath="LocalCivSortKey"
                                    HeaderStyle="{StaticResource CenteredColumnHeader}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Width="30" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding LocalCivIcon}" Width="24" Height="24" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasLocalCivIcon,Converter={StaticResource BoolToVisibility}}"/>
                    <!-- Custom civilizations without a bundled emblem still show a visible
                         abbreviation, rather than silently looking like missing data. -->
                    <Border Width="26" Height="26" Background="#FF3B303D" BorderBrush="#FF7A5C70"
                            BorderThickness="1" CornerRadius="13" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasLocalCivFallback,Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding LocalCivAbbreviation}" FontSize="10" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Date" Binding="{Binding DisplayDateOnly}" SortMemberPath="Started" Width="88" ElementStyle="{StaticResource GridTextWithoutTooltip}"/>
            <DataGridTemplateColumn Header="Match" Width="1.75*" MinWidth="96" SortMemberPath="Title">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="5,0,2,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" markup:Civ5MarkupText.Markup="{Binding DisplayTitle}" FontSize="12"
                               Foreground="{StaticResource Fg}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" BorderBrush="#FF8E6943" BorderThickness="1"
                            Background="#FF423225" CornerRadius="3" Padding="3,1"
                            VerticalAlignment="Center" Margin="5,0,0,0"
                            Visibility="{Binding ReviewPending,Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="REVIEW" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFD28D"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn x:Name="MatchResultColumn" Header="Result" Binding="{Binding DisplayResult}" Width="1.15*" MinWidth="82" ElementStyle="{StaticResource GridTextWithoutTooltip}"/>
            <DataGridTextColumn x:Name="MatchMapColumn" Header="Map" Binding="{Binding MapEnglish}" Width="0.90*" MinWidth="70" ElementStyle="{StaticResource GridTextWithoutTooltip}"/>
            <DataGridTextColumn Header="Players" Binding="{Binding Participants}" Width="72" ElementStyle="{StaticResource GridTextWithoutTooltip}"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="No matches match the current filters" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"
                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding MatchView.IsEmpty}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </Grid>

    <Border Grid.Column="1" Background="{StaticResource Sidebar}" BorderBrush="#FF352832" BorderThickness="1,0,0,0" CornerRadius="0" Padding="13,12,13,12">
      <Grid>
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMatch}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
          <TextBlock markup:Civ5MarkupText.Markup="{Binding SelectedMatch.DisplayTitle}" FontSize="16" FontWeight="SemiBold"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"/>
          <TextBlock Text="{Binding SelectedMatch.DisplayDate}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding SelectedMatch.DisplayResult}" FontSize="12" FontWeight="SemiBold" Foreground="#FFE3A3B8" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Grid Grid.Row="1" MinHeight="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="1.20*" MinHeight="110"/>
            <RowDefinition Height="0.80*" MinHeight="96"/>
          </Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
            <StackPanel>
              <!-- Compact two-column metadata saves enough height to show the players at 1080 x 600. -->
              <Grid Margin="0,0,3,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="22"/>
                  <RowDefinition Height="23"/>
                  <RowDefinition Height="22"/>
                  <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Map" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedMatch.MapEnglish}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="Civilization" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Image Source="{Binding SelectedMatch.LocalCivIcon}" Width="19" Height="19" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,5,0"
                         Visibility="{Binding SelectedMatch.HasLocalCivIcon,Converter={StaticResource BoolToVisibility}}"/>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedMatch.LocalCivEnglish}" FontSize="12"
                             Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="Winner" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" markup:Civ5MarkupText.Markup="{Binding SelectedMatch.WinnerName}" FontSize="12"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Text="End turn" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedMatch.EndTurnDisplay}" FontSize="12"
                           Foreground="{StaticResource Fg}" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="Participants" Style="{StaticResource FieldLabel}" Margin="0,6,0,3"/>
              <StackPanel Orientation="Horizontal" Margin="0,1,3,3">
                <Image Source="{Binding SelectedMatch.LocalCivIcon}" Width="18" Height="18" Stretch="Uniform"
                       Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding SelectedMatch.HasLocalCivIcon,Converter={StaticResource BoolToVisibility}}"/>
                <Border Width="18" Height="18" Background="#FF3B303D" BorderBrush="#FF7A5C70"
                        BorderThickness="1" CornerRadius="9" Margin="0,0,6,0" VerticalAlignment="Center"
                        Visibility="{Binding SelectedMatch.HasLocalCivFallback,Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding SelectedMatch.LocalCivAbbreviation}" FontSize="8"
                             FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock markup:Civ5MarkupText.Markup="{Binding SelectedMatch.LocalParticipantLabel}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding SelectedMatch.PlayerDetails}" Margin="0,0,3,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ParticipantLink}" CommandParameter="{Binding SteamId}"
                            Click="OpenMatchParticipant" AutomationProperties.Name="Open player card">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Image Source="{Binding CivilizationIcon}" Width="18" Height="18" Stretch="Uniform"
                               Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasCivilizationIcon,Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock markup:Civ5MarkupText.Markup="{Binding Nickname}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#FFE6AFC6"/>
                              <Setter Property="TextDecorations" Value="Underline"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                  <Setter Property="Foreground" Value="#FFFFDFE9"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1" MinHeight="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Note" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <TextBox x:Name="MatchNote" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MinHeight="96" Padding="9,7"
                     TextChanged="MatchNoteChanged" LostKeyboardFocus="MatchNoteLostFocus"/>
          </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,9,0,0">
          <Button Style="{StaticResource MatchActionButton}" Click="EditMatch" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Data="M 3,17 L 3,21 L 7,21 L 19,9 L 15,5 Z M 14,6 L 18,10"
                    Stroke="#FFEBD7E1" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                    Fill="Transparent" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
              <TextBlock Text="Edit match"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MatchReviewButton}" Click="CompleteReview" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Data="M 3,11 L 8,16 L 19,4" Stroke="#FFB3E3C4" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                    Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
              <TextBlock Text="Mark reviewed"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MatchDeleteButton}" Click="DeleteMatch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Data="M 3,6 L 19,6 M 8,3 L 14,3 M 6,7 L 7,20 L 17,20 L 18,7 M 10,10 L 10,17 M 14,10 L 14,17"
                    Stroke="#FFFFA2B5" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                    Fill="Transparent" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
              <TextBlock Text="Delete match"/>
            </StackPanel>
          </Button>
        </StackPanel>
        </Grid>
        <TextBlock Text="Select a match" FontSize="13" Foreground="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMatch}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</UserControl>
