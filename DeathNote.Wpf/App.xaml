<Application x:Class="DeathNote.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <!-- Cohesive dark burgundy theme; all surfaces share the same opaque base. -->
    <SolidColorBrush x:Key="Base" Color="#FF18151B"/>
    <SolidColorBrush x:Key="Sidebar" Color="#FF201A22"/>
    <SolidColorBrush x:Key="Surface" Color="#FF211B24"/>
    <SolidColorBrush x:Key="Card" Color="#FF241E27"/>
    <SolidColorBrush x:Key="Field" Color="#FF2B222C"/>
    <SolidColorBrush x:Key="Line" Color="#FF463540"/>
    <SolidColorBrush x:Key="Accent" Color="#FFAA5873"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#FF593044"/>
    <SolidColorBrush x:Key="Fg" Color="#FFF3EAF0"/>
    <SolidColorBrush x:Key="Muted" Color="#FFB6A4AF"/>
    <SolidColorBrush x:Key="Disabled" Color="#FF796973"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="GridText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>

    <!-- Numeric columns align their values directly below W / L / Q instead of centering. -->
    <Style x:Key="StatGridText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="GridTextWithoutTooltip" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
      <Setter Property="ToolTip" Value="{x:Null}"/>
    </Style>
    <Style x:Key="NumericGridText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <!-- Button family: one template, several semantic variants. -->
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="#FF513044"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#FF71475A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonShell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonShell" Property="Background" Value="#FF704057"/>
                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#FFA0617B"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonShell" Property="Background" Value="#FF402331"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Tag" Value="Danger"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="ButtonShell" Property="Background" Value="#FF713347"/>
                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#FFAB5A6E"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Tag" Value="Close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="ButtonShell" Property="Background" Value="#FF9A3046"/>
                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#FF9A3046"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Tag" Value="Green"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="ButtonShell" Property="Background" Value="#FF438B69"/>
                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#FF6DC391"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Tag" Value="Ban"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="ButtonShell" Property="Background" Value="#FFAF4259"/>
                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#FFDB7E91"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Tag" Value="Green"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="ButtonShell" Property="Background" Value="#FF285C43"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Tag" Value="Ban"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="ButtonShell" Property="Background" Value="#FF702737"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#FFD58CA4"/>
                <Setter TargetName="ButtonShell" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#FF82415A"/>
      <Setter Property="BorderBrush" Value="#FF9A5972"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#FF2F2530"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Tag" Value="Danger"/>
      <Setter Property="Background" Value="#FF45242F"/>
      <Setter Property="BorderBrush" Value="#FF6B3848"/>
    </Style>
    <!-- Semantic action colors remain distinct during hover and press. -->
    <Style x:Key="PlayerSaveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Tag" Value="Green"/>
      <Setter Property="Background" Value="#FF367559"/>
      <Setter Property="BorderBrush" Value="#FF4F9773"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Match-details actions and player-details actions share the same dimensions and colors. -->
    <Style x:Key="PlayerBanButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
      <Setter Property="Background" Value="#FF4B2733"/>
      <Setter Property="BorderBrush" Value="#FF854456"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="31"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="PlayerSecondaryButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
      <Setter Property="Background" Value="#192F2532"/>
      <Setter Property="BorderBrush" Value="#FF51404D"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="31"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Player card: refined, full-width actions, retaining original placement. -->
    <!-- Unframed icon action: Steam link / lightweight secondary controls. -->
    <Style x:Key="BareIconButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.76"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <!-- Consistent compact actions in the match details sidebar. -->
    <Style x:Key="MatchActionButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
      <Setter Property="Height" Value="31"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#192F2532"/>
      <Setter Property="BorderBrush" Value="#FF51404D"/>
    </Style>
    <Style x:Key="MatchReviewButton" TargetType="Button" BasedOn="{StaticResource MatchActionButton}">
      <Setter Property="Background" Value="#FF284136"/>
      <Setter Property="BorderBrush" Value="#FF456E59"/>
      <Setter Property="Tag" Value="Green"/>
    </Style>
    <Style x:Key="MatchDeleteButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
      <Setter Property="Height" Value="31"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#FF4B2733"/>
      <Setter Property="BorderBrush" Value="#FF854456"/>
    </Style>
    <Style x:Key="CounterButton" TargetType="Button" BasedOn="{StaticResource BareIconButton}">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- Counter controls use vector icons instead of glyph text so the plus / minus stay bold, large and clearly colored. -->
    <Style x:Key="CounterMinusButton" TargetType="Button" BasedOn="{StaticResource CounterButton}">
      <Setter Property="Foreground" Value="#FFE6677F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent" Width="24" Height="24">
              <Path Data="M 7.5,12 L 16.5,12" Stroke="{TemplateBinding Foreground}" StrokeThickness="3"
                    StrokeStartLineCap="Square" StrokeEndLineCap="Square" Stretch="None"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFF8EA1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CounterPlusButton" TargetType="Button" BasedOn="{StaticResource CounterButton}">
      <Setter Property="Foreground" Value="#FF66D88E"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent" Width="24" Height="24">
              <Path Data="M 7.5,12 L 16.5,12 M 12,7.5 L 12,16.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="3"
                    StrokeStartLineCap="Square" StrokeEndLineCap="Square" Stretch="None"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FF8AE7AC"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="NavMark" Width="3" Background="{StaticResource Accent}" CornerRadius="2"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Height="18" Visibility="Collapsed"/>
                <ContentPresenter Margin="12,0,7,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavSurface" Property="Background" Value="#FF392732"/>
              </Trigger>
              <Trigger Property="Tag" Value="Active">
                <Setter TargetName="NavSurface" Property="Background" Value="#FF513044"/>
                <Setter TargetName="NavMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Tag" Value="Active"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="NavSurface" Property="Background" Value="#FF674055"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="NavSurface" Property="BorderBrush" Value="#FFB7728A"/>
                <Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="#FFF9E9F0"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                <TextBlock x:Name="InputWatermark" Text="{TemplateBinding Tag}"
                           Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="{TemplateBinding FontSize}"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value=""/>
                  <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="InputWatermark" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#FF705364"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#FFBB718E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Search inputs have no watermark; the magnifier never overlaps typed text.
         A fixed content-host inset is used instead of the global TextBox padding. -->
    <Style x:Key="SearchInputTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="SearchBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" SnapsToDevicePixels="True" ClipToBounds="True">
              <Grid>
                <Grid Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="9,0,0,0" IsHitTestVisible="False">
                  <Ellipse Width="10" Height="10" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
                  <Line X1="9" Y1="9" X2="15" Y2="15" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/>
                </Grid>
                <ScrollViewer x:Name="PART_ContentHost" Margin="31,0,7,0" Focusable="False"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="#FF705364"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="#FFBB718E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Scroll bars: light Windows chrome is replaced in DataGrid, text fields and panels. -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="#FF6C5864" CornerRadius="4" Margin="2,2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="Background" Value="#FFAF7D93"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Grip" Property="Background" Value="#FFD591AA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="VerticalSlimScroll" TargetType="ScrollBar">
      <Grid Width="9" Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource SlimScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HorizontalSlimScroll" TargetType="ScrollBar">
      <Grid Height="9" Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="False">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource SlimScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template" Value="{StaticResource VerticalSlimScroll}"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="9"/>
          <Setter Property="Template" Value="{StaticResource HorizontalSlimScroll}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Full ComboBox template (including popup); the native white dropdown is gone. -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="3"
                    Margin="2,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#FF513446"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#FF663B50"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="9,0,26,0"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropToggle" Background="Transparent" BorderThickness="0" Focusable="False"
                            ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ComboSurface" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="1" CornerRadius="5">
                      <Grid>
                        <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          Margin="9,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsHitTestVisible="False"/>
                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFCEAFBF" Width="8" Height="4"
                              Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#FF866176"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#FFBB718E"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#FF2B222E" BorderBrush="#FF795369" BorderThickness="1" CornerRadius="6"
                        MaxHeight="245" Padding="3" Margin="0,2,0,0">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="2,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border x:Name="CheckSurface" Width="14" Height="14" CornerRadius="3" BorderThickness="1"
                      BorderBrush="#FF75566A" Background="{StaticResource Field}" VerticalAlignment="Center">
                <Path x:Name="CheckMark" Data="M 2 7 L 5 10 L 11 3" Stroke="White" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckSurface" Property="Background" Value="#FF84445C"/>
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#FFBC7792"/>
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#FFC387A0"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeight" Value="31"/>
      <Setter Property="ColumnHeaderHeight" Value="35"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="EnableColumnVirtualization" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <!-- Keep half a viewport on either side: lower the work per large jump
           while retaining a buffer for ordinary wheel scrolling. -->
      <Setter Property="VirtualizingPanel.CacheLength" Value="0.5,0.5"/>
      <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="RowBackground" Value="Transparent"/>
      <Setter Property="AlternatingRowBackground" Value="#132A222A"/>
      <Setter Property="AlternationCount" Value="2"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>
    <!-- Sorting: selected header has a restrained tint and tiny directional chevron.
         Glyph gets its own column so neither titles nor the table rows shift. -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Padding" Value="5,3"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid Background="Transparent">
              <Border x:Name="HeaderSurface" CornerRadius="4" Margin="1,2" Background="Transparent"/>
              <Border Background="#443D3A40" Height="1" VerticalAlignment="Bottom" Margin="3,0,3,0"/>
              <Grid Margin="3,0,3,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="11"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Content,RelativeSource={RelativeSource TemplatedParent}}"
                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{TemplateBinding Foreground}"/>
                <Path x:Name="AscendingMark" Grid.Column="1" Data="M 1,6 L 5,2 L 9,6"
                      Stroke="#FFEAC3D0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="10" Height="9" Stretch="None" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Path x:Name="DescendingMark" Grid.Column="1" Data="M 1,2 L 5,6 L 9,2"
                      Stroke="#FFEAC3D0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="10" Height="9" Stretch="None" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>
              <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="5" Cursor="SizeWE">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
              </Thumb>
              <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="5" Cursor="SizeWE">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
              </Thumb>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#182F2430"/></Trigger>
              <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="AscendingMark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="HeaderSurface" Property="Background" Value="#2A523647"/>
                <Setter Property="ToolTip" Value="Ascending · click for descending"/>
              </Trigger>
              <Trigger Property="SortDirection" Value="Descending">
                <Setter TargetName="DescendingMark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="HeaderSurface" Property="Background" Value="#2A523647"/>
                <Setter Property="ToolTip" Value="Descending · click to clear sorting"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Favorite column: star and values share their left edge; the sorting glyph has reserved width. -->
    <Style x:Key="FavoriteSortHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid Background="Transparent">
              <Border x:Name="StarHover" CornerRadius="4" Background="Transparent" Margin="1,2"/>
              <Border Background="#443D3A40" Height="1" VerticalAlignment="Bottom" Margin="3,0,3,0"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="★" FontSize="19" FontWeight="SemiBold"
                           Foreground="#FFF1C66F" HorizontalAlignment="Left" Margin="7,0,0,0" VerticalAlignment="Center"/>
                <Path x:Name="AscendingMark" Grid.Column="1" Data="M 1,6 L 5,2 L 9,6" Stroke="#FFEAC3D0"
                      StrokeThickness="1.5" Width="10" Height="9" Stretch="None" Visibility="Collapsed" VerticalAlignment="Center"/>
                <Path x:Name="DescendingMark" Grid.Column="1" Data="M 1,2 L 5,6 L 9,2" Stroke="#FFEAC3D0"
                      StrokeThickness="1.5" Width="10" Height="9" Stretch="None" Visibility="Collapsed" VerticalAlignment="Center"/>
              </Grid>
              <Thumb x:Name="PART_LeftHeaderGripper" Width="4" HorizontalAlignment="Left" Cursor="SizeWE">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
              </Thumb>
              <Thumb x:Name="PART_RightHeaderGripper" Width="4" HorizontalAlignment="Right" Cursor="SizeWE">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
              </Thumb>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StarHover" Property="Background" Value="#182F2430"/></Trigger>
              <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="AscendingMark" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="DescendingMark" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Unsortable favorite header has no reserved arrow space. -->
    <Style x:Key="UnsortableColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="Transparent" Padding="2,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <!-- Transparent, rounded row surfaces; cells do not obscure selection corners. -->
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridRow">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="RowSurface" Background="{TemplateBinding Background}" Margin="2,1"
                      CornerRadius="5"/>
              <DataGridCellsPresenter x:Name="PART_CellsPresenter" Margin="2,0"/>
              <DataGridDetailsPresenter x:Name="PART_DetailsPresenter" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter TargetName="RowSurface" Property="Background" Value="#172E2732"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="#233E2B37"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="#FF593449"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="RowSurface" Property="BorderBrush" Value="#FFB984A0"/>
                <Setter TargetName="RowSurface" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="3,2"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#FF302530"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
  </Application.Resources>
</Application>
